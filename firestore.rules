// Firestore Security Rules para o MVP Hostel Match
// Este arquivo contém as regras de segurança recomendadas para o Firebase Firestore
// Para aplicar essas regras:
// 1. Copie o conteúdo abaixo
// 2. Acesse o Firebase Console > Firestore Database > Rules
// 3. Cole as regras e publique

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Other authenticated users can read basic profile info (for events and chat)
      allow read: if request.auth != null;

      // Prevent users from changing certain fields
      allow update: if request.auth != null
                   && request.auth.uid == userId
                   && !('uid' in request.resource.data)
                   && !('email' in request.resource.data)
                   && !('createdAt' in request.resource.data);
    }

    // Events collection
    match /events/{eventId} {
      // Anyone can read events (for discovery)
      allow read: if request.auth != null;

      // Only authenticated users can create events
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.creatorId
                   && request.resource.data.participantCount == 1
                   && request.resource.data.status == 'active';

      // Only event creator can update/delete events
      allow update, delete: if request.auth != null
                           && request.auth.uid == resource.data.creatorId;

      // Subcollection for participants
      match /participants/{participantId} {
        // Anyone can read participants of an event
        allow read: if request.auth != null;

        // Users can add themselves as participants
        allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.userId;

        // Users can remove themselves or creator can remove anyone
        allow delete: if request.auth != null
                     && (request.auth.uid == resource.data.userId
                         || request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.creatorId);
      }
    }

    // Participants collection (alternative structure)
    match /participants/{participantId} {
      // Read access for authenticated users
      allow read: if request.auth != null;

      // Users can create participation records for themselves
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.userId;

      // Users can delete their own participation
      allow delete: if request.auth != null
                   && request.auth.uid == resource.data.userId;
    }

    // Messages collection (chat messages)
    match /messages/{messageId} {
      // Only participants of an event can read its messages
      allow read: if request.auth != null
                 && request.auth.uid in get(/databases/$(database)/documents/events/$(resource.data.eventId)/participants).data.userIds;

      // Only authenticated users can send messages to events they participate in
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.senderId
                   && request.auth.uid in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)/participants).data.userIds;

      // Users can only delete their own messages
      allow delete: if request.auth != null
                   && request.auth.uid == resource.data.senderId;
    }

    // Reports collection
    match /reports/{reportId} {
      // Only the reporter can read their own reports
      allow read: if request.auth != null
                 && request.auth.uid == resource.data.reporterId;

      // Authenticated users can create reports
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.reporterId;

      // No updates or deletes allowed on reports
      allow update, delete: if false;
    }

    // Block any other collections not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Regras adicionais para Storage (Firebase Storage Rules)
// Para aplicar no Firebase Storage:
