// Firestore Security Rules para o MVP Hostel Match
// Este arquivo contém as regras de segurança recomendadas para o Firebase Firestore
// Para aplicar essas regras:
// 1. Copie o conteúdo abaixo
// 2. Acesse o Firebase Console > Firestore Database > Rules
// 3. Cole as regras e publique

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for events and chat)
      allow read: if request.auth != null;

      // Only the owner can create/update their profile
      allow create: if request.auth != null && request.auth.uid == userId;

      // Prevent users from changing protected fields on update
      allow update: if request.auth != null
                   && request.auth.uid == userId
                   && !('uid' in request.resource.data)
                   && !('email' in request.resource.data)
                   && !('createdAt' in request.resource.data);

      // Users cannot delete their own profile
      allow delete: if false;
    }

    // Events collection
    match /events/{eventId} {
      // Any authenticated user can read events (discovery)
      allow read: if request.auth != null;

      // Authenticated users can create events as themselves
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.creatorId
                   && request.resource.data.participantCount == 1
                   && request.resource.data.status == 'active';

      // Creator can update their own events
      allow update: if request.auth != null
                   && request.auth.uid == resource.data.creatorId;

      // Creator can delete their own events
      allow delete: if request.auth != null
                   && request.auth.uid == resource.data.creatorId;

      // Participants subcollection (stored under events/{eventId}/participants)
      match /participants/{participantId} {
        // Any authenticated user can read participants
        allow read: if request.auth != null;

        // Users can add themselves as participants
        allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.userId;

        // Participant can remove themselves; creator can remove anyone
        allow delete: if request.auth != null
                     && (request.auth.uid == resource.data.userId
                         || request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.creatorId);
      }

      // Messages subcollection (stored under events/{eventId}/messages)
      match /messages/{messageId} {
        // Any participant of the event can read messages
        allow read: if request.auth != null;

        // Authenticated users can send messages as themselves
        allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.senderId;

        // Only the sender can delete their own messages
        allow delete: if request.auth != null
                     && request.auth.uid == resource.data.senderId;

        // Messages cannot be edited
        allow update: if false;
      }
    }

    // Regra de collection group para participants (necessária para queries de estatísticas do usuário)
    match /{path=**}/participants/{participantId} {
      allow read: if request.auth != null;
    }

    // Reports collection
    match /reports/{reportId} {
      // Only the reporter can read their own reports
      allow read: if request.auth != null
                 && request.auth.uid == resource.data.reporterId;

      // Authenticated users can create reports as themselves
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.reporterId;

      // Reports are immutable once created
      allow update, delete: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Nota: Armazenamento de arquivos (fotos de perfil, imagens de eventos, etc.)
// é gerenciado pelo Appwrite Storage.
// As URLs dos arquivos são armazenadas nos documentos do Firestore.
