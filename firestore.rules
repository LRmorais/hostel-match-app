      // Users can only upload/update their own profile picture
      allow write: if request.auth != null
                  && request.auth.uid == userId
                  && resource.size < 5 * 1024 * 1024; // Max 5MB
    }

    // Event images (for future use)
    match /event-images/{eventId}/{fileName} {
      // Anyone can read event images
      allow read: if request.auth != null;

      // Only event creator can upload images
      allow write: if request.auth != null
                  && request.auth.uid == firestore.get(/databases/(default)/documents/events/$(eventId)).data.creatorId
                  && resource.size < 10 * 1024 * 1024; // Max 10MB
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
