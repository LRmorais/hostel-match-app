# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Firebase SDK snippet

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: Firebase Measurement ID for Analytics
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Appwrite Configuration
# Get these values from Appwrite Console

# Appwrite Server Endpoint
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (get from Appwrite Console)
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your-project-id

# Your Database ID (create in Appwrite Console > Databases)
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your-database-id

# Your Storage Bucket ID (create in Appwrite Console > Storage)
EXPO_PUBLIC_APPWRITE_STORAGE_ID=your-storage-bucket-id

# Development
EXPO_PUBLIC_ENV=development

# Hotels API
# Base URL da API de hotéis/hostels
EXPO_PUBLIC_HOTELS_API_URL=https://api.your-hotels-provider.com/v1

# Chave de autenticação (enviada como X-API-KEY em todas as requisições)
EXPO_PUBLIC_HOTELS_API_KEY=your-hotels-api-key

